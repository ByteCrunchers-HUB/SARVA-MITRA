# ==============================================================================
# SMART AGRICULTURE MONITORING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Hardware Serial Configuration (ESP32)
# When running locally with physical ESP32 plugged in: ENABLE_SERIAL=true, SERIAL_PORT=COM9
# When deployed on cloud (Render): set ENABLE_SERIAL=false (cloud has no physical USB port)
ENABLE_SERIAL=true
SERIAL_PORT=COM9
SERIAL_BAUDRATE=115200

# ThingSpeak cloud channel (leave blank to use Serial/HTTP-only mode)
# Set these in Render for cloud fetch; keep the channel private and use its Read API Key.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_READ_CACHE_SECONDS=10

# Geographic Coordinates & Location Details (Vijayawada trained point)
LATITUDE=16.51
LONGITUDE=80.52
LOCATION_NAME=Vijayawada

# Weather API Endpoint (Open-Meteo free public endpoints)
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Independent Machine Learning Engine Endpoint
ML_API_URL=https://sarva-mitra-ml.onrender.com/predict

# Separately Implemented RAG Advisory Pipeline Endpoint
RAG_API_URL=https://sarva-mitra-rag.onrender.com/advisory

# Network & Timeout Configuration (Seconds) - 60s for Render free tier spin-up
REQUEST_TIMEOUT=60

# History Duplication Strategy for ML Input (true/false)
ALLOW_DUPLICATE_HISTORY=true

# Default Device ID
DEVICE_ID=ESP32_01

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application Server Host and Port
HOST=127.0.0.1
PORT=8000
