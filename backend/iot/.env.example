# ==============================================================================
# SARVA-MITRA API BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environmental history API and model-location matching
NASA_POWER_DAILY_URL=https://power.larc.nasa.gov/api/temporal/daily/point
EXTERNAL_DATA_CACHE_SECONDS=900
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
MODEL_LOCATION_MAX_DISTANCE_KM=250

# Defaults for the standalone weather endpoint; /api/process uses UI request values.
LATITUDE=16.51
LONGITUDE=80.52
LOCATION_NAME=Vijayawada

# Weather API Endpoint (Open-Meteo free public endpoints)
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Independent Machine Learning Engine Endpoint
ML_API_URL=https://sarva-mitra-ml.onrender.com/predict

# Separately Implemented RAG Advisory Pipeline Endpoint
RAG_API_URL=https://sarva-mitra-rag.onrender.com/advisory

# Network & Timeout Configuration (Seconds) - 60s for Render free tier spin-up
REQUEST_TIMEOUT=60

# Never synthesize missing history rows for ML
ALLOW_DUPLICATE_HISTORY=false

# Default API client ID
DEVICE_ID=API_CLIENT

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application Server Host and Port
HOST=127.0.0.1
PORT=8000
