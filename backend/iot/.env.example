# ==============================================================================
# SMART AGRICULTURE MONITORING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Hardware Serial Configuration (ESP32)
SERIAL_PORT=COM9
SERIAL_BAUDRATE=115200

# Geographic Coordinates & Location Details
LATITUDE=16.5062
LONGITUDE=80.6480
LOCATION_NAME=Vijayawada

# Weather API Endpoint (Open-Meteo provides free public endpoints)
WEATHER_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Independent Machine Learning Engine Endpoint
ML_API_URL=http://sarva-mitra.onrender.com/predict

# Separately Implemented RAG Pipeline Endpoint
RAG_API_URL=http://localhost:8002/rag/query

# Network & Timeout Configuration (Seconds)
REQUEST_TIMEOUT=30

# Temporary 8-Day History Duplication Strategy (true/false)
# Set to 'true' during initial integration testing when fewer than 8 real records exist.
ALLOW_DUPLICATE_HISTORY=true

# Default Device ID
DEVICE_ID=ESP32_01

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application Server Host and Port
HOST=127.0.0.1
PORT=8000
